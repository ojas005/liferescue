# Non-secret, browser-visible configuration ONLY. Never put keys or tokens in NEXT_PUBLIC_* variables.
# Base URL of the FastAPI backend (no trailing slash). Example for local dev: http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Set to 1 to use the built-in MOCK API (Next route handlers under /api). Dev/test fixture only.
NEXT_PUBLIC_USE_MOCK=0
