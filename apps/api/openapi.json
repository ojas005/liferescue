{
  "components": {
    "schemas": {
      "Approval": {
        "additionalProperties": false,
        "properties": {
          "approval_id": {
            "title": "Approval Id",
            "type": "string"
          },
          "bound_digest": {
            "title": "Bound Digest",
            "type": "string"
          },
          "decided_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Decided At"
          },
          "decided_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Decided By"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "policy_version": {
            "title": "Policy Version",
            "type": "string"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "requested_at": {
            "format": "date-time",
            "title": "Requested At",
            "type": "string"
          },
          "risk": {
            "$ref": "#/components/schemas/RiskLevel"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/ApprovalStatus",
            "default": "pending"
          },
          "step_id": {
            "title": "Step Id",
            "type": "string"
          },
          "summary": {
            "title": "Summary",
            "type": "string"
          }
        },
        "required": [
          "approval_id",
          "run_id",
          "step_id",
          "bound_digest",
          "risk",
          "summary",
          "policy_version",
          "requested_at",
          "expires_at"
        ],
        "title": "Approval",
        "type": "object"
      },
      "ApprovalDecisionRequest": {
        "additionalProperties": false,
        "properties": {
          "decision": {
            "enum": [
              "approve",
              "deny"
            ],
            "title": "Decision",
            "type": "string"
          },
          "reason": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "required": [
          "decision"
        ],
        "title": "ApprovalDecisionRequest",
        "type": "object"
      },
      "ApprovalStatus": {
        "enum": [
          "pending",
          "approved",
          "denied",
          "expired",
          "consumed",
          "revoked"
        ],
        "title": "ApprovalStatus",
        "type": "string"
      },
      "CancelRunRequest": {
        "additionalProperties": false,
        "properties": {
          "reason": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "title": "CancelRunRequest",
        "type": "object"
      },
      "CheckResult": {
        "additionalProperties": false,
        "properties": {
          "check_id": {
            "title": "Check Id",
            "type": "string"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "passed": {
            "title": "Passed",
            "type": "boolean"
          }
        },
        "required": [
          "check_id",
          "passed",
          "detail"
        ],
        "title": "CheckResult",
        "type": "object"
      },
      "CreateRunRequest": {
        "additionalProperties": false,
        "properties": {
          "input": {
            "additionalProperties": true,
            "title": "Input",
            "type": "object"
          },
          "workflow_id": {
            "title": "Workflow Id",
            "type": "string"
          },
          "workflow_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Workflow Version"
          }
        },
        "required": [
          "workflow_id",
          "input"
        ],
        "title": "CreateRunRequest",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "title": "Error",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "error",
          "message"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "EventType": {
        "description": "Timeline event types. The first nine are the brief's; the last two are ASSUMPTIONS.",
        "enum": [
          "intent",
          "evidence",
          "research",
          "plan",
          "policy",
          "approval",
          "action",
          "verification",
          "audit",
          "state_change",
          "error"
        ],
        "title": "EventType",
        "type": "string"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "properties": {
          "contract_version": {
            "title": "Contract Version",
            "type": "string"
          },
          "model_adapter": {
            "enum": [
              "nebius",
              "mock"
            ],
            "title": "Model Adapter",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "contract_version",
          "model_adapter"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "IntentResult": {
        "additionalProperties": false,
        "description": "Structured output of the INTENT stage (platform-generic; domain data goes in `entities`).",
        "properties": {
          "category": {
            "title": "Category",
            "type": "string"
          },
          "entities": {
            "additionalProperties": true,
            "title": "Entities",
            "type": "object"
          },
          "missing_fields": {
            "items": {
              "type": "string"
            },
            "title": "Missing Fields",
            "type": "array"
          },
          "summary": {
            "title": "Summary",
            "type": "string"
          },
          "urgency": {
            "$ref": "#/components/schemas/RiskLevel",
            "default": "low"
          }
        },
        "required": [
          "summary",
          "category"
        ],
        "title": "IntentResult",
        "type": "object"
      },
      "PlanStep": {
        "additionalProperties": false,
        "properties": {
          "action_type": {
            "title": "Action Type",
            "type": "string"
          },
          "params": {
            "additionalProperties": true,
            "title": "Params",
            "type": "object"
          },
          "rationale": {
            "title": "Rationale",
            "type": "string"
          },
          "step_id": {
            "title": "Step Id",
            "type": "string"
          },
          "tool_name": {
            "title": "Tool Name",
            "type": "string"
          }
        },
        "required": [
          "step_id",
          "action_type",
          "tool_name",
          "rationale"
        ],
        "title": "PlanStep",
        "type": "object"
      },
      "PolicyDecision": {
        "additionalProperties": false,
        "properties": {
          "action_digest": {
            "title": "Action Digest",
            "type": "string"
          },
          "outcome": {
            "$ref": "#/components/schemas/PolicyOutcome"
          },
          "policy_version": {
            "title": "Policy Version",
            "type": "string"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          },
          "risk": {
            "$ref": "#/components/schemas/RiskLevel"
          },
          "rule_id": {
            "title": "Rule Id",
            "type": "string"
          },
          "step_id": {
            "title": "Step Id",
            "type": "string"
          }
        },
        "required": [
          "step_id",
          "outcome",
          "risk",
          "rule_id",
          "reason",
          "policy_version",
          "action_digest"
        ],
        "title": "PolicyDecision",
        "type": "object"
      },
      "PolicyOutcome": {
        "enum": [
          "allow",
          "needs_approval",
          "deny"
        ],
        "title": "PolicyOutcome",
        "type": "string"
      },
      "RiskLevel": {
        "enum": [
          "low",
          "medium",
          "high",
          "critical"
        ],
        "title": "RiskLevel",
        "type": "string"
      },
      "RunRecord": {
        "additionalProperties": false,
        "properties": {
          "contract_version": {
            "title": "Contract Version",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "decisions": {
            "items": {
              "$ref": "#/components/schemas/PolicyDecision"
            },
            "title": "Decisions",
            "type": "array"
          },
          "input": {
            "additionalProperties": true,
            "title": "Input",
            "type": "object"
          },
          "intent": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/IntentResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "owner": {
            "default": "demo-user",
            "title": "Owner",
            "type": "string"
          },
          "plan": {
            "items": {
              "$ref": "#/components/schemas/PlanStep"
            },
            "title": "Plan",
            "type": "array"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/ToolResult"
            },
            "title": "Results",
            "type": "array"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/RunState",
            "default": "intent"
          },
          "terminal_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Terminal Reason"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "verification": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/VerificationResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "version": {
            "default": 0,
            "title": "Version",
            "type": "integer"
          },
          "workflow_id": {
            "title": "Workflow Id",
            "type": "string"
          },
          "workflow_version": {
            "title": "Workflow Version",
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "workflow_id",
          "workflow_version",
          "contract_version",
          "input",
          "created_at",
          "updated_at"
        ],
        "title": "RunRecord",
        "type": "object"
      },
      "RunResponse": {
        "additionalProperties": false,
        "description": "Current snapshot. `state` is the pipeline stage; `pending_approvals` is what the UI must show for a decision.",
        "properties": {
          "approvals": {
            "items": {
              "$ref": "#/components/schemas/Approval"
            },
            "title": "Approvals",
            "type": "array"
          },
          "last_seq": {
            "default": 0,
            "title": "Last Seq",
            "type": "integer"
          },
          "run": {
            "$ref": "#/components/schemas/RunRecord"
          }
        },
        "required": [
          "run"
        ],
        "title": "RunResponse",
        "type": "object"
      },
      "RunState": {
        "description": "Run lifecycle. The first nine are the brief's pipeline; the last four are terminal (ASSUMPTION).",
        "enum": [
          "intent",
          "evidence",
          "research",
          "plan",
          "policy",
          "approval",
          "action",
          "verification",
          "audit",
          "completed",
          "failed",
          "denied",
          "cancelled"
        ],
        "title": "RunState",
        "type": "string"
      },
      "TimelineEvent": {
        "additionalProperties": false,
        "properties": {
          "event_id": {
            "title": "Event Id",
            "type": "string"
          },
          "payload": {
            "additionalProperties": true,
            "title": "Payload",
            "type": "object"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "seq": {
            "title": "Seq",
            "type": "integer"
          },
          "step": {
            "$ref": "#/components/schemas/RunState"
          },
          "ts": {
            "format": "date-time",
            "title": "Ts",
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/EventType"
          }
        },
        "required": [
          "event_id",
          "run_id",
          "seq",
          "ts",
          "step",
          "type"
        ],
        "title": "TimelineEvent",
        "type": "object"
      },
      "TimelinePage": {
        "additionalProperties": false,
        "properties": {
          "events": {
            "items": {
              "$ref": "#/components/schemas/TimelineEvent"
            },
            "title": "Events",
            "type": "array"
          },
          "next_seq": {
            "title": "Next Seq",
            "type": "integer"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "terminal": {
            "title": "Terminal",
            "type": "boolean"
          }
        },
        "required": [
          "run_id",
          "events",
          "next_seq",
          "terminal"
        ],
        "title": "TimelinePage",
        "type": "object"
      },
      "ToolResult": {
        "additionalProperties": false,
        "properties": {
          "action_digest": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Action Digest"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "mocked": {
            "default": false,
            "title": "Mocked",
            "type": "boolean"
          },
          "output": {
            "additionalProperties": true,
            "title": "Output",
            "type": "object"
          },
          "status": {
            "enum": [
              "ok",
              "error"
            ],
            "title": "Status",
            "type": "string"
          },
          "tool_name": {
            "title": "Tool Name",
            "type": "string"
          }
        },
        "required": [
          "tool_name",
          "status"
        ],
        "title": "ToolResult",
        "type": "object"
      },
      "VerificationResult": {
        "additionalProperties": false,
        "properties": {
          "checks": {
            "items": {
              "$ref": "#/components/schemas/CheckResult"
            },
            "title": "Checks",
            "type": "array"
          },
          "passed": {
            "title": "Passed",
            "type": "boolean"
          }
        },
        "required": [
          "passed",
          "checks"
        ],
        "title": "VerificationResult",
        "type": "object"
      },
      "WorkflowSummary": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "title": "Description",
            "type": "string"
          },
          "input_schema": {
            "additionalProperties": true,
            "title": "Input Schema",
            "type": "object"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          },
          "workflow_id": {
            "title": "Workflow Id",
            "type": "string"
          }
        },
        "required": [
          "workflow_id",
          "version",
          "title",
          "description",
          "input_schema"
        ],
        "title": "WorkflowSummary",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "One generic run API for every workflow. No authentication in the sprint (PROPOSED ASSUMPTION - REQUIRES HUMAN APPROVAL).",
    "title": "LifeRescue Run API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness and contract/model-adapter info (PROPOSED ASSUMPTION)"
      }
    },
    "/api/runs": {
      "post": {
        "operationId": "createRun",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRunRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Validation error"
          }
        },
        "summary": "Create a run; the runtime starts at INTENT and advances until done or blocked on approval",
        "tags": [
          "runs"
        ]
      }
    },
    "/api/runs/{run_id}": {
      "get": {
        "operationId": "getRun",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Validation error"
          }
        },
        "summary": "Get a run snapshot with its approvals",
        "tags": [
          "runs"
        ]
      }
    },
    "/api/runs/{run_id}/approvals/{approval_id}": {
      "post": {
        "operationId": "decideApproval",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "approval_id",
            "required": true,
            "schema": {
              "title": "Approval Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-Actor-Id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Actor-Id"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApprovalDecisionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict (illegal transition, approval not pending, concurrent change)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Validation error"
          }
        },
        "summary": "Approve or deny one pending approval (bound to the action digest, single use)",
        "tags": [
          "runs"
        ]
      }
    },
    "/api/runs/{run_id}/cancel": {
      "post": {
        "operationId": "cancelRun",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-Actor-Id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Actor-Id"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/CancelRunRequest"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Body"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict (illegal transition, approval not pending, concurrent change)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Validation error"
          }
        },
        "summary": "Cancel a run (only before ACTION starts)",
        "tags": [
          "runs"
        ]
      }
    },
    "/api/runs/{run_id}/timeline": {
      "get": {
        "operationId": "getTimeline",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "after_seq",
