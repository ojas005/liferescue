# Copy to .env for local development (never commit .env). All values below are placeholders.
# Fail-closed defaults: with nothing set the app runs as production + nebius and refuses to start without NEBIUS_API_KEY.
LIFERESCUE_ENV=local
LIFERESCUE_MODEL_ADAPTER=mock
DATABASE_URL=postgresql+psycopg://liferescue:liferescue_dev@localhost:5432/liferescue
# Only when LIFERESCUE_MODEL_ADAPTER=nebius (and LIFERESCUE_ENV != test/ci). Put the real key in your shell or
# secret manager, NOT in a file in git. Read only by app/security/keys.py (credential broker adapter).
# NEBIUS_API_KEY=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
