{
  "version": 1,
  "comment": "Single source of redaction patterns (KAN-45 spec 6.3). Rules with a gitleaks_rule id mirror .gitleaks.toml and are checked by the parity test (T-22); rules with null are Python-only runtime extras. Names and shapes only; no values.",
  "rules": [
    {
      "id": "liferescue-xai-api-key",
      "kind": "xai_key",
      "regex": "\\bxai-[A-Za-z0-9]{40,}\\b",
      "group": 0,
      "gitleaks_rule": "liferescue-xai-api-key"
    },
    {
      "id": "liferescue-nvidia-api-key",
      "kind": "nvidia_key",
      "regex": "\\bnvapi-[A-Za-z0-9_\\-]{40,}\\b",
      "group": 0,
      "gitleaks_rule": "liferescue-nvidia-api-key"
    },
    {
      "id": "liferescue-tavily-api-key",
      "kind": "tavily_key",
      "regex": "\\btvly-[A-Za-z0-9_\\-]{20,}\\b",
      "group": 0,
      "gitleaks_rule": "liferescue-tavily-api-key"
    },
    {
      "id": "liferescue-atlassian-api-token",
      "kind": "atlassian_token",
      "regex": "\\bATATT3[A-Za-z0-9_\\-=]{50,}\\b",
      "group": 0,
      "gitleaks_rule": "liferescue-atlassian-api-token"
    },
    {
      "id": "py-github-token",
      "kind": "github_token",
      "regex": "\\b(?:gh[pousr]_[A-Za-z0-9]{36,}|github_pat_[A-Za-z0-9_]{22,})\\b",
      "group": 0,
      "gitleaks_rule": null
    },
    {
      "id": "py-openai-style-key",
      "kind": "sk_key",
      "regex": "\\bsk-(?:proj-|ant-)?[A-Za-z0-9_\\-]{20,}\\b",
      "group": 0,
      "gitleaks_rule": null
    },
    {
      "id": "liferescue-nebius-credential-assignment",
      "kind": "nebius_credential",
      "regex": "(?i)\\bnebius[_\\-]?(?:api[_\\-]?key|token|secret|service[_\\-]?account[_\\-]?key)\\b[\"']?\\s*[:=]\\s*[\"']?([A-Za-z0-9_\\-\\.=+/]{20,})",
      "group": 1,
      "gitleaks_rule": "liferescue-nebius-credential-assignment"
    },
    {
      "id": "liferescue-url-embedded-password",
      "kind": "url_password",
      "regex": "(?i)\\b(?:postgres(?:ql)?|redis|rediss|amqps?|mongodb(?:\\+srv)?|mysql|https?)://[^\\s:/@'\"]+:([^\\s@'\"]{6,})@[^\\s'\"]+",
      "group": 1,
      "gitleaks_rule": "liferescue-url-embedded-password",
      "allow_match_regexes": [
        "(?i):(password|changeme|example|placeholder|<[^>]+>|\\$\\{[^}]+\\}|\\*+|x{3,})@"
      ]
    },
    {
      "id": "liferescue-github-app-private-key-file-ref",
      "kind": "private_key",
      "regex": "-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----(?:[\\s\\S]*?-----END (?:RSA |EC |OPENSSH )?PRIVATE KEY-----|[\\s\\S]*\\Z)",
      "group": 0,
      "gitleaks_rule": "liferescue-github-app-private-key-file-ref"
    },
    {
      "id": "py-private-key-any",
      "kind": "private_key",
      "regex": "-----BEGIN [A-Z0-9 ]{0,30}PRIVATE KEY(?: BLOCK)?-----(?:[\\s\\S]*?-----END [A-Z0-9 ]{0,30}PRIVATE KEY(?: BLOCK)?-----|[\\s\\S]*\\Z)",
      "group": 0,
      "gitleaks_rule": null
    },
    {
      "id": "py-bearer-token",
      "kind": "bearer_token",
      "regex": "(?i)\\b(?:bearer|basic)\\s+([A-Za-z0-9._~+/\\-]{8,}={0,2})",
      "group": 1,
      "gitleaks_rule": null
    },
    {
      "id": "py-authorization-header",
      "kind": "auth_header",
      "regex": "(?i)\\b(?:proxy-)?authorization[\"']?\\s*[:=]\\s*[\"']?(?!(?:bearer|basic)\\s)(?!\\[REDACTED)([^\\s\"',;]{8,})",
      "group": 1,
      "gitleaks_rule": null
    },
    {
      "id": "py-cookie-header",
      "kind": "cookie",
      "regex": "(?i)\\b(?:set-)?cookie[\"']?\\s*[:=]\\s*[\"']?(?!\\[REDACTED)([^\\r\\n\"']{8,})",
      "group": 1,
      "gitleaks_rule": null
    },
    {
      "id": "py-url-query-secret",
      "kind": "url_param",
      "regex": "(?i)[?&;](?:api[_-]?key|apikey|access[_-]?token|token|password|passwd|secret|client[_-]?secret|auth)=(?!\\[REDACTED)([^&\\s\"'#]{4,})",
      "group": 1,
      "gitleaks_rule": null
    },
    {
      "id": "py-secret-assignment",
      "kind": "assignment",
      "regex": "(?i)\\b(?:api[_-]?key|apikey|secret|password|passwd|token|private[_-]?key|client[_-]?secret)\\b[\"']?\\s*[:=]\\s*[\"']?(?!\\[REDACTED)([^\\s\"',;&]{8,})",
      "group": 1,
      "gitleaks_rule": null
    }
  ]
}
