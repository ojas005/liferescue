# LifeRescue local development environment - TEMPLATE.
# Copy to .env (make env does this and generates a random POSTGRES_PASSWORD). .env is gitignored.
# This file holds PLACEHOLDERS ONLY. Never put a real key, token or password here, and never commit .env.
# Names marked (proposed) are suggestions for LR 04 / LR 05; rename them freely and update this file.

# --- Runtime ---------------------------------------------------------------------------------------------
APP_ENV=local
# (proposed) structured JSON logs; see analysis LR10-observability-plan.md
LOG_FORMAT=json
LOG_LEVEL=INFO

# --- PostgreSQL (docker compose service "db") ------------------------------------------------------------
POSTGRES_USER=liferescue
# Placeholder. `make env` replaces it with a random value in your .env. Used only for the local container,
# which listens on 127.0.0.1 only.
POSTGRES_PASSWORD=REPLACE_ME_LOCAL_ONLY
POSTGRES_DB=liferescue
POSTGRES_TEST_DB=liferescue_test
POSTGRES_HOST_PORT=5432
# DATABASE_URL is derived by scripts/dev from the values above when it is not set. Set it explicitly only if you
# need a different driver prefix or a password with special characters.
# DATABASE_URL=

# --- API (apps/api, FastAPI) -----------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000

# --- Web (apps/web, Next.js) -----------------------------------------------------------------------------
WEB_HOST=127.0.0.1
WEB_PORT=3000
# (proposed) browser-visible base URL of the API; only non-secret values may use the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# --- Model gateway (brief: ModelGateway / MockModel / NebiusModel) ----------------------------------------
# (proposed) mock = MockModel, no network, no key needed. Switch to nebius only with a key (see below).
MODEL_PROVIDER=mock
# OpenAI-compatible endpoint named in the KAN-50 proposal; not a secret.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Real keys come from the credential broker (packages/credential_broker, KAN-45). If you must test locally before
# the broker is wired, put the key ONLY in your gitignored .env, never here, never in chat, logs or screenshots.
NEBIUS_API_KEY=
TAVILY_API_KEY=
