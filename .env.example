# LifeRescue Configuration Template
# Copy to .env for local overrides (never commit .env or raw API credentials)

# Application Environment (development, test, production)
APP_ENV=development

# Storage Path (SQLite database file, or :memory:)
DB_PATH=./liferescue.db

# AI Provider: "mock" (deterministic, no credentials) or "nebius" (NVIDIA Nemotron on Nebius Token Factory; "nvidia" is an alias)
AI_PROVIDER=mock

# Demo & Simulation Mode (true ensures all external notifications and dispatches are simulated)
DEMO_MODE=true

# Server Host and Port
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# NVIDIA Nemotron on Nebius Token Factory (OpenAI-compatible). Leave the key blank for mock mode.
# Put the key ONLY in your local .env or shell env, never in Git. NVIDIA_API_KEY is accepted as an alias.
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_BASE_URL=https://api.tokenfactory.nebius.com/v1/
AI_TIMEOUT_S=20
# (key last so the blank value is never followed by a token-shaped line)
NEBIUS_API_KEY=
