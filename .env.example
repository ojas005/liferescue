# LifeRescue Configuration Template
# Copy to .env for local overrides (never commit .env or raw API credentials)

# Application Environment (development, test, production)
APP_ENV=development

# Storage Path (SQLite database file, or :memory:)
DB_PATH=./liferescue.db

# AI Provider ("mock" for deterministic local runs and testing, "nvidia" for NVIDIA NIM/Nebius)
AI_PROVIDER=mock

# Demo & Simulation Mode (true ensures all external notifications and dispatches are simulated)
DEMO_MODE=true

# Server Host and Port
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Future NVIDIA / Nebius AI Cloud Integration (leave blank for local mock mode)
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
