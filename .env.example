# LifeRescue configuration template. Copy to .env for local overrides.
# Never commit .env or any real credential. This file contains no secrets.

APP_ENV=development
DB_PATH=./liferescue.db

# AI provider: "mock" (deterministic, no credentials) or "nvidia"
# (NVIDIA Nemotron on Nebius Token Factory; "nebius" is accepted as an alias).
AI_PROVIDER=mock
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_BASE_URL=https://api.tokenfactory.nebius.com/v1/
AI_TIMEOUT_S=20

# Demo mode: all dispatches and notifications are simulated.
DEMO_MODE=true

HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
# CORS_ORIGINS (comma-separated) overrides the localhost allowlist; "*" is ignored.

# DEMO_ACCESS_TOKEN is REQUIRED if HOST is not 127.0.0.1/localhost. Set it in the shell/host
# environment only (a long random value); never put the real value in any committed file.
# Set DEMO_REQUIRE_TOKEN=1 whenever a tunnel/proxy exposes the server (forces the token on localhost).
DEMO_REQUIRE_TOKEN=0

# Nebius Token Factory key (NVIDIA_API_KEY is an alias). Leave blank for mock mode.
# Key last so the blank value is never followed by a token-shaped line.
NEBIUS_API_KEY=
